# Configuration of Card Surveys (one VARIABLE=value per line, no quotes).
# The installer writes /etc/cardsurveys/cardsurveys.env (or ~/cardsurveys/.env in user mode) from these settings.
CARDS_SECRET_KEY=replace-with-a-long-random-string
CARDS_HOME=/var/lib/cardsurveys
CARDS_DATABASE_URL=sqlite:////var/lib/cardsurveys/cardsurveys.sqlite3
CARDS_URL_PREFIX=/cards
CARDS_BIND=127.0.0.1:8002
CARDS_PUBLIC_BASE_URL=https://survey.example.org
CARDS_BEHIND_PROXY=1
CARDS_SECURE_COOKIES=1
CARDS_LANGUAGES=pl,en
CARDS_DEFAULT_LANGUAGE=pl
CARDS_ALLOWED_EMAIL_DOMAINS=uj.edu.pl,student.uj.edu.pl,doctoral.uj.edu.pl
CARDS_REGISTRATION_OPEN=1
CARDS_EMAIL_CONFIRMATION=1
CARDS_SESSION_HOURS=8
CARDS_MAIL_BACKEND=smtp
CARDS_MAIL_DIR=/var/lib/cardsurveys/mail
CARDS_SMTP_HOST=smtp.example.org
CARDS_SMTP_PORT=587
CARDS_SMTP_STARTTLS=1
CARDS_SMTP_SSL=0
CARDS_SMTP_USER=
CARDS_SMTP_PASSWORD=
CARDS_MAIL_SENDER=Card Surveys <no-reply@example.org>
CARDS_BACKUP_DAYS=30
CARDS_WORKERS=2
CARDS_THREADS=4
